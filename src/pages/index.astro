---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import avatar from "@assets/avatar.png";
import type { CollectionEntry } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const principles = [
  {
    title: "信頼できる設計",
    body: "利用者の生活に入るアプリだからこそ、分かりやすさ、安心感、不要なデータを持たない方針を大切にしています。",
  },
  {
    title: "小さく磨く開発",
    body: "機能を増やす前に、何度も触る導線と画面の読みやすさを整え、毎日使える軽さを優先します。",
  },
  {
    title: "公開後も育てる姿勢",
    body: "ユーザーの声を拾い、使われる場面を観察しながら、実用性の高い改善を積み重ねます。",
  },
];
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <section class="pt-4 pb-20">
    <Container>
      <div class="animate max-w-3xl">
        <div class="mb-6 flex items-center gap-4">
          <Image
            src={avatar}
            alt="あんでぃのアイコン"
            width={160}
            height={160}
            loading="eager"
            class="size-16 rounded-full border border-[#17211d]/10 shadow-lg shadow-[#17211d]/10 sm:size-20"
          />
          <p class="text-sm font-medium text-[#1d6f5c] uppercase">
            あんでぃ / Independent App Developer
          </p>
        </div>
        <h1
          class="max-w-3xl text-4xl leading-[1.08] font-semibold text-[#17211d] sm:text-5xl lg:text-6xl"
        >
          日常に寄り添うアプリを、丁寧に設計して届けます。
        </h1>
        <p
          class="mt-7 max-w-2xl text-base leading-8 text-[#17211d]/68 sm:text-lg"
        >
          子育てや習慣づけなど、身近な課題を扱う個人開発アプリを制作しています。使う人の負担を増やさず、自然に続けられる体験を目指しています。
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="/projects"
            class="rounded-md bg-[#17211d] px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-[#1d6f5c] focus-visible:bg-[#1d6f5c]"
          >
            アプリを見る
          </a>
          <a
            href="/contact"
            class="rounded-md border border-[#17211d]/12 bg-white px-5 py-3 text-sm font-medium text-[#17211d] transition-colors hover:border-[#1d6f5c]/35 hover:text-[#1d6f5c] focus-visible:border-[#1d6f5c]/35 focus-visible:text-[#1d6f5c]"
          >
            お問い合わせ
          </a>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-y border-[#17211d]/10 bg-white/55 py-16">
    <Container>
      <div class="grid gap-8 lg:grid-cols-[0.72fr_1fr] lg:items-start">
        <div class="animate">
          <p class="text-sm font-medium text-[#1d6f5c] uppercase">
            Design Principles
          </p>
          <h2 class="mt-3 text-3xl font-semibold text-[#17211d]">
            見た目だけでなく、使われ方まで整える。
          </h2>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {
            principles.map((principle) => (
              <section class="animate border-t border-[#17211d]/10 pt-5">
                <h3 class="font-semibold text-[#17211d]">{principle.title}</h3>
                <p class="mt-3 text-sm leading-7 text-[#17211d]/65">
                  {principle.body}
                </p>
              </section>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <section class="py-20">
    <Container>
      <div class="animate mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-[#1d6f5c] uppercase">
            Applications
          </p>
          <h2 class="mt-3 text-3xl font-semibold text-[#17211d]">
            開発したアプリケーション
          </h2>
        </div>
        <Link href="/projects">すべて見る</Link>
      </div>
      <ul class="not-prose grid gap-5 lg:grid-cols-2">
        {
          projects.map((project) => (
            <li class="animate">
              <ArrowCard entry={project} />
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section class="border-t border-[#17211d]/10 pt-16">
    <Container>
      <div class="grid gap-12 lg:grid-cols-[1fr_0.82fr]">
        <section class="animate">
          <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-sm font-medium text-[#1d6f5c] uppercase">Notes</p>
              <h2 class="mt-3 text-3xl font-semibold text-[#17211d]">
                開発メモ
              </h2>
            </div>
            <Link href="/blog">記事を見る</Link>
          </div>
          <ul class="not-prose grid gap-5">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section
          class="animate rounded-lg border border-[#17211d]/10 bg-white p-6"
          data-pagefind-ignore
        >
          <p class="text-sm font-medium text-[#1d6f5c] uppercase">Contact</p>
          <h2 class="mt-3 text-2xl font-semibold text-[#17211d]">
            アプリに関するご連絡
          </h2>
          <p class="mt-4 leading-8 text-[#17211d]/65">
            ご質問、ご要望、フィードバックがあればお問い合わせフォームからお送りください。開発中のアプリ改善の参考にします。
          </p>
          <div class="mt-7 flex flex-wrap gap-2">
            <a
              href="/contact"
              class="rounded-md bg-[#17211d] px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-[#1d6f5c] focus-visible:bg-[#1d6f5c]"
            >
              フォームへ
            </a>
            {
              SOCIALS.map((SOCIAL) => (
                <a
                  href={SOCIAL.HREF}
                  target="_blank"
                  rel="noreferrer"
                  class="rounded-md border border-[#17211d]/10 px-4 py-2.5 text-sm font-medium text-[#17211d]/70 transition-colors hover:border-[#1d6f5c]/35 hover:text-[#17211d]"
                >
                  {SOCIAL.NAME}
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </Container>
  </section>
</Layout>
