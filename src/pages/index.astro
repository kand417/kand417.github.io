---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import avatar from "@assets/avatar.png";
import heroBg from "@assets/hero-bg.webp";
import type { CollectionEntry } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

// icon: inner SVG of a 24x24 stroke icon
const principles = [
  {
    title: "信頼できる設計",
    body: "利用者の生活に入るアプリだからこそ、分かりやすさ、安心感、不要なデータを持たない方針を大切にしています。",
    icon: '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 9.5-4-1.2-7-5-7-9.5V6l7-3z" /><path d="M9 12l2 2 4-4" />',
  },
  {
    title: "小さく磨く開発",
    body: "機能を増やす前に、何度も触る導線と画面の読みやすさを整え、毎日使える軽さを優先します。",
    icon: '<path d="M12 4l1.8 4.6 4.7 1.9-4.7 1.9L12 17l-1.8-4.6-4.7-1.9 4.7-1.9z" /><path d="M19 15l.7 1.8 1.8.7-1.8.7L19 20l-.7-1.8-1.8-.7 1.8-.7z" />',
  },
  {
    title: "公開後も育てる姿勢",
    body: "ユーザーの声を拾い、使われる場面を観察しながら、実用性の高い改善を積み重ねます。",
    icon: '<path d="M12 21v-9" /><path d="M12 12c0-3.6-2.6-6.5-7-6.5 0 3.6 2.6 6.5 7 6.5z" /><path d="M12 14.5c0-3.2 2.3-5.8 6.5-5.8 0 3.2-2.3 5.8-6.5 5.8z" />',
  },
];
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <!-- -mt-28 cancels main's pt-28 so the background extends behind the fixed header -->
  <section
    class="relative isolate -mt-28 overflow-hidden pt-40 pb-28 sm:pt-48 sm:pb-36 lg:pt-52 lg:pb-44"
  >
    <div class="absolute inset-0 -z-10 animate-hero-in" aria-hidden="true">
      <Image
        src={heroBg}
        alt=""
        widths={[768, 1280, 1536]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="size-full animate-hero-drift object-cover object-[72%_center]"
      />
      <div
        class="absolute inset-0 bg-white/70 sm:bg-white/45 lg:bg-linear-to-r lg:from-white/90 lg:via-white/40 lg:to-transparent"
      >
      </div>
      <div
        class="absolute inset-x-0 bottom-0 h-40 bg-linear-to-b from-transparent to-white"
      >
      </div>
    </div>

    <Container>
      <div class="max-w-2xl">
        <div class="animate flex items-center gap-3.5">
          <div class="relative">
            <Image
              src={avatar}
              alt="あんでぃのアイコン"
              width={128}
              height={128}
              loading="eager"
              class="size-14 rounded-full bg-white shadow-lg ring-4 shadow-brand-900/10 ring-white"
            />
            <span class="absolute right-0 bottom-0.5 flex size-3.5">
              <span
                class="absolute inline-flex size-full animate-soft-pulse rounded-full bg-brand-400"
              ></span>
              <span
                class="relative inline-flex size-3.5 rounded-full bg-brand-500 ring-2 ring-white"
              ></span>
            </span>
          </div>
          <div class="leading-tight">
            <p class="font-display text-lg font-bold text-slate-800">
              あんでぃ
            </p>
            <p class="mt-1 text-xs tracking-wide text-slate-500">
              Independent App Developer
            </p>
          </div>
        </div>
        <h1
          class="animate mt-9 text-[2.1rem] leading-[1.45] font-bold text-slate-800 sm:text-5xl sm:leading-[1.35] lg:text-[3.4rem]"
        >
          日常に寄り添うアプリを、<br class="hidden sm:block" /><span
            class="marker">丁寧に</span
          >設計して届けます。
        </h1>
        <p
          class="animate mt-7 max-w-xl text-base leading-8 text-slate-600 sm:text-lg sm:leading-9"
        >
          子育てや習慣づけなど、身近な課題を扱う個人開発アプリを制作しています。使う人の負担を増やさず、自然に続けられる体験を目指しています。
        </p>
        <div class="animate mt-10 flex flex-wrap gap-3">
          <a href="/projects" class="group btn btn-primary">
            アプリを見る
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="size-4 fill-none stroke-current stroke-2 transition-transform duration-300 group-hover:translate-x-0.5"
              aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
            >
          </a>
          <a href="/contact" class="btn btn-secondary">お問い合わせ</a>
        </div>
      </div>
    </Container>
  </section>

  <section class="pt-4 pb-24">
    <Container>
      <div class="animate mx-auto max-w-2xl text-center">
        <p class="eyebrow">Design Principles</p>
        <h2 class="mt-4 text-[1.7rem] font-bold text-slate-800 sm:text-4xl">
          見た目だけでなく、使われ方まで整える。
        </h2>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          principles.map((principle) => (
            <section class="animate group rounded-3xl border border-slate-200/80 bg-white p-7 shadow-sm shadow-slate-900/[0.03]">
              <div class="grid size-12 place-items-center rounded-2xl bg-brand-50 text-brand-600 transition-colors duration-500 group-hover:bg-brand-600 group-hover:text-white">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="size-6 fill-none stroke-current stroke-[1.6]"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={principle.icon}
                />
              </div>
              <h3 class="mt-6 text-lg font-bold text-slate-800">
                {principle.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">
                {principle.body}
              </p>
            </section>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="border-y border-slate-200/70 bg-slate-50/80 py-24">
    <Container>
      <div class="animate mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Applications</p>
          <h2 class="mt-4 text-[1.7rem] font-bold text-slate-800 sm:text-3xl">
            開発したアプリケーション
          </h2>
        </div>
        <Link
          href="/projects"
          underline={false}
          class="text-sm font-semibold text-brand-700">すべて見る →</Link
        >
      </div>
      <ul class="not-prose grid gap-5 lg:grid-cols-2">
        {
          projects.map((project) => (
            <li class="animate">
              <ArrowCard entry={project} />
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section class="pt-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-[1fr_0.8fr] lg:items-start">
        <section>
          <div
            class="animate mb-10 flex flex-wrap items-end justify-between gap-4"
          >
            <div>
              <p class="eyebrow">Notes</p>
              <h2
                class="mt-4 text-[1.7rem] font-bold text-slate-800 sm:text-3xl"
              >
                開発メモ
              </h2>
            </div>
            <Link
              href="/blog"
              underline={false}
              class="text-sm font-semibold text-brand-700">記事を見る →</Link
            >
          </div>
          <ul class="not-prose grid gap-5">
            {
              blog.map((post) => (
                <li class="animate">
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section
          class="animate relative isolate overflow-hidden rounded-3xl border border-brand-100 bg-linear-to-br from-brand-50 via-white to-white p-8"
          data-pagefind-ignore
        >
          <div
            class="absolute -top-20 -right-20 -z-10 size-56 rounded-full bg-brand-100/80 blur-3xl"
            aria-hidden="true"
          >
          </div>
          <p class="eyebrow">Contact</p>
          <h2 class="mt-4 text-2xl font-bold text-slate-800">
            アプリに関するご連絡
          </h2>
          <p class="mt-4 leading-8 text-slate-600">
            ご質問、ご要望、フィードバックがあればお問い合わせフォームからお送りください。開発中のアプリ改善の参考にします。
          </p>
          <div class="mt-8 flex flex-wrap gap-2.5">
            <a href="/contact" class="btn btn-primary">フォームへ</a>
            {
              SOCIALS.map((SOCIAL) => (
                <a
                  href={SOCIAL.HREF}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-secondary"
                >
                  {SOCIAL.NAME}
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </Container>
  </section>
</Layout>
