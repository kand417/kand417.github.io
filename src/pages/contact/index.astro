---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";

const checklist = [
  "アプリの名前",
  "お使いの端末と OS のバージョン（例：iPhone 15、iOS 26.1）",
  "不具合の場合は、起きたときの操作の手順や画面のスクリーンショット",
];
---

<Layout
  title="お問い合わせ"
  description="アプリに関するお問い合わせページです。"
>
  <Container>
    <section class="grid gap-10 lg:grid-cols-[0.72fr_1fr] lg:items-start">
      <div class="animate">
        <p class="eyebrow">Contact</p>
        <h1 class="mt-4 page-title">アプリに関するご連絡はこちらから。</h1>
        <p class="mt-5 text-base leading-8 text-slate-600">
          ご質問、ご要望、フィードバックをメールでお送りください。いただいた内容は、今後の改善や新しいアプリづくりの参考にします。
        </p>
        {
          SOCIALS.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-2">
              {SOCIALS.map((SOCIAL) => (
                <a
                  href={SOCIAL.HREF}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-secondary"
                >
                  {SOCIAL.NAME}
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div
        class="animate rounded-3xl border border-brand-100 bg-linear-to-br from-brand-50 via-white to-white p-8"
        data-email
        data-email-user={SITE.EMAIL.USER}
        data-email-domain={SITE.EMAIL.DOMAIN}
      >
        <p class="eyebrow">Email</p>
        <h2 class="mt-4 text-2xl font-bold text-slate-800">
          メールでのお問い合わせ
        </h2>

        <p class="mt-5 text-xl font-semibold break-all text-slate-800">
          <span data-email-text hidden></span>
          <noscript>
            {SITE.EMAIL.USER} ＠ {SITE.EMAIL.DOMAIN}
            <span class="mt-2 block text-sm font-normal text-slate-500">
              迷惑メール対策のため「＠」を全角にしています。半角の「@」に直してお送りください。
            </span>
          </noscript>
        </p>

        <div class="mt-6 flex flex-wrap gap-2.5" data-email-actions hidden>
          <a class="btn btn-primary" data-email-link>メールを送る</a>
          <button type="button" class="btn btn-secondary" data-email-copy>
            アドレスをコピー
          </button>
          <span class="sr-only" role="status" data-email-status></span>
        </div>

        <h3 class="mt-10 text-lg font-bold text-slate-800">
          書いていただけると助かること
        </h3>
        <ul
          class="mt-3 list-disc space-y-1 pl-5 text-sm leading-7 text-slate-600"
        >
          {checklist.map((item) => <li>{item}</li>)}
        </ul>

        <div
          class="mt-8 space-y-2 border-t border-brand-100 pt-6 text-sm leading-7 text-slate-600"
        >
          <p>
            メールでお問い合わせいただくと、送信元のメールアドレスがこちらに届きます。いただいたアドレスは返信のためだけに使い、ほかの目的には使いません。
          </p>
          <p>
            内容によっては、お返事に時間がかかったり、お答えできなかったりする場合があります。
          </p>
        </div>
      </div>
    </section>
  </Container>
</Layout>

<script>
  const COPY_LABEL = "アドレスをコピー";
  let resetTimer: number | undefined;

  function setupEmail() {
    const root = document.querySelector<HTMLElement>("[data-email]");
    if (!root) return;

    const { emailUser, emailDomain } = root.dataset;
    if (!emailUser || !emailDomain) return;
    const address = `${emailUser}@${emailDomain}`;

    const text = root.querySelector<HTMLElement>("[data-email-text]");
    const actions = root.querySelector<HTMLElement>("[data-email-actions]");
    const link = root.querySelector<HTMLAnchorElement>("[data-email-link]");
    const copy = root.querySelector<HTMLButtonElement>("[data-email-copy]");
    const status = root.querySelector<HTMLElement>("[data-email-status]");

    if (text) {
      text.textContent = address;
      text.hidden = false;
    }
    if (link) link.href = `mailto:${address}`;
    if (actions) actions.hidden = false;

    copy?.addEventListener("click", async () => {
      let message: string;
      try {
        await navigator.clipboard.writeText(address);
        message = "コピーしました";
      } catch {
        message = "コピーできませんでした";
      }
      copy.textContent = message;
      if (status) status.textContent = message;
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        copy.textContent = COPY_LABEL;
        if (status) status.textContent = "";
      }, 2000);
    });
  }

  // ClientRouter でページを移動したときにも動くように、astro:page-load で実行する
  document.addEventListener("astro:page-load", setupEmail);
</script>
