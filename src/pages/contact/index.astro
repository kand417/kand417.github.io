---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SOCIALS } from "@consts";
---

<Layout
  title="お問い合わせ"
  description="アプリに関するお問い合わせページです。"
>
  <Container>
    <section class="grid gap-10 lg:grid-cols-[0.72fr_1fr] lg:items-start">
      <div class="animate">
        <p class="eyebrow">Contact</p>
        <h1 class="mt-4 page-title">アプリに関するご連絡はこちらから。</h1>
        <p class="mt-5 text-base leading-8 text-slate-600">
          ご質問、ご要望、フィードバックをお送りください。いただいた内容は、今後の改善や新しいアプリづくりの参考にします。
        </p>
        {
          SOCIALS.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-2">
              {SOCIALS.map((SOCIAL) => (
                <a
                  href={SOCIAL.HREF}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-secondary"
                >
                  {SOCIAL.NAME}
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div
        class="animate overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5"
      >
        <iframe
          title="お問い合わせフォーム"
          src="https://docs.google.com/forms/d/e/1FAIpQLScxM1eGKw6Dz_OhFEZUP656XGJjQQ_FJVm-w0ynveX7OHjldQ/viewform?embedded=true"
          class="h-[760px] w-full bg-white"
          loading="lazy">読み込んでいます...</iframe
        >
      </div>
    </section>
  </Container>
</Layout>
