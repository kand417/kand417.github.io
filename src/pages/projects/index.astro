---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { PROJECTS } from "@consts";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <section data-pagefind-ignore>
      <div class="animate max-w-3xl">
        <p
          class="text-sm font-medium text-[#1d6f5c] uppercase dark:text-[#69c4ad]"
        >
          Projects
        </p>
        <h1
          class="mt-3 text-4xl leading-[1.12] font-semibold text-[#17211d] sm:text-5xl dark:text-white"
        >
          生活に近い課題を、扱いやすいアプリにする。
        </h1>
        <p
          class="mt-5 text-base leading-8 text-[#17211d]/65 dark:text-white/65"
        >
          個人開発したアプリケーションの一覧です。企画、UI設計、実装、公開準備まで、プロダクトとして使われる状態を意識して作っています。
        </p>
      </div>
      <ul class="not-prose mt-12 grid gap-5 lg:grid-cols-2">
        {
          projects.map((project) => (
            <li class="animate">
              <ArrowCard entry={project} />
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>
