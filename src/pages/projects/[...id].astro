---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import TableOfContents from "@components/TableOfContents.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project) => ({
    params: { id: project.id },
    props: project,
  }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content, headings } = await render(project);
const projectImage = project.data.image;
const metaItems = [
  {
    label: "Date",
    value: project.data.date.toLocaleDateString("ja-JP", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }),
  },
  { label: "Platform", value: project.data.platform },
  { label: "Role", value: project.data.role },
  { label: "Status", value: project.data.status },
].filter((item) => Boolean(item.value));
---

<Layout
  title={project.data.title}
  description={project.data.description}
  image={projectImage?.src}
>
  <Container>
    <div class="animate">
      <BackToPrevious href="/projects">Projectsへ戻る</BackToPrevious>
    </div>

    <section
      class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start"
    >
      <div class="animate max-w-3xl">
        <p class="eyebrow">Application</p>
        <h1 class="mt-4 page-title">
          {project.data.title}
        </h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          {project.data.description}
        </p>
        <div
          class="mt-6 flex flex-wrap items-center gap-2 text-sm text-slate-500"
        >
          <FormattedDate date={project.data.date} />
          {
            project.body && (
              <>
                <span aria-hidden="true">/</span>
                <span>{readingTime(project.body)}</span>
              </>
            )
          }
        </div>
        {
          (project.data.demoURL || project.data.repoURL) && (
            <nav class="mt-8 flex flex-wrap gap-3" aria-label="Project links">
              {project.data.demoURL && (
                <a
                  href={project.data.demoURL}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-primary"
                >
                  デモを見る
                </a>
              )}
              {project.data.repoURL && (
                <a
                  href={project.data.repoURL}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-secondary"
                >
                  リポジトリ
                </a>
              )}
            </nav>
          )
        }
      </div>

      <aside class="animate rounded-2xl border border-slate-200 bg-white p-5">
        <dl class="divide-y divide-slate-200">
          {
            metaItems.map((item) => (
              <div class="py-4 first:pt-0 last:pb-0">
                <dt class="text-xs font-medium text-slate-500 uppercase">
                  {item.label}
                </dt>
                <dd class="mt-2 font-medium text-slate-800">{item.value}</dd>
              </div>
            ))
          }
        </dl>
        {
          project.data.stack && project.data.stack.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2 border-t border-slate-200 pt-5">
              {project.data.stack.map((item) => (
                <span class="chip">{item}</span>
              ))}
            </div>
          )
        }
      </aside>
    </section>

    {
      projectImage && (
        <figure class="animate mt-10 overflow-hidden rounded-2xl border border-slate-200 bg-white">
          <img
            src={projectImage.src}
            width={projectImage.width}
            height={projectImage.height}
            alt={`${project.data.title}のアイキャッチ画像`}
            class="w-full"
          />
        </figure>
      )
    }

    {
      project.data.highlights && project.data.highlights.length > 0 && (
        <section class="animate mt-12 grid gap-4 border-y border-slate-200 py-6 md:grid-cols-3">
          {project.data.highlights.map((highlight) => (
            <div class="flex gap-4">
              <span
                class="mt-2 size-2 shrink-0 rounded-full bg-brand-400"
                aria-hidden="true"
              />
              <p class="text-sm leading-7 text-slate-600">{highlight}</p>
            </div>
          ))}
        </section>
      )
    }

    {
      headings.length > 0 && (
        <div class="mt-10 max-w-3xl">
          <TableOfContents headings={headings} />
        </div>
      )
    }

    <article class="animate mt-10 max-w-3xl">
      <Content />
    </article>
  </Container>
</Layout>
