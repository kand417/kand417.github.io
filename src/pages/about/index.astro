---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { ABOUT, SOCIALS } from "@consts";
import { Image } from "astro:assets";
import avatar from "@assets/avatar.png";

const career = [
  {
    period: "2023 – 2026",
    title: "生成AI・AIエージェント向け SaaS の開発",
    body: "Azure 上で提供する SaaS のフロントエンドを、React / TypeScript で設計・実装・レビューしました。フロントエンドリーダー、スクラムマスター、プロダクトオーナーも経験し、Claude Code を前提にした開発プロセスづくりにも関わりました。",
  },
  {
    period: "2018 – 2023",
    title: "コンテナ運用管理製品の企画・開発",
    body: "開発リーダーとして、React のフロントエンドと Python のバックエンドで製品を開発しました。Kubernetes や OpenShift の技術検証も担当しました。",
  },
  {
    period: "2017",
    title: "エッジ向け Java アプリケーション基盤の企画・開発",
    body: "Java / OSGi をベースにしたアプリケーション基盤を、開発リーダーとして企画から開発まで進めました。",
  },
  {
    period: "2007 – 2016",
    title: "企業向け Web アプリケーションサーバ製品の開発",
    body: "Java による機能開発と保守、Windows Server / RHEL 環境での検証を長く担当しました。",
  },
];

const skills = [
  {
    category: "Frontend / Mobile",
    items: ["TypeScript", "React", "React Native", "Expo", "Zustand"],
  },
  {
    category: "Backend",
    items: ["Java", "Python", "FastAPI", "OSGi"],
  },
  {
    category: "Cloud / Infra",
    items: ["Microsoft Azure", "Docker", "Kubernetes", "OpenShift", "Linux"],
  },
  {
    category: "AI-assisted Development",
    items: ["Claude Code", "Codex", "GitHub Copilot"],
  },
  {
    category: "Team",
    items: ["Scrum", "Scrum Master", "Product Owner", "開発リーダー"],
  },
];

const values = [
  {
    title: "自分の手で作り続ける",
    body: "リーダーやスクラムマスターの経験は、開発の背景や優先順位を理解するために活かしつつ、設計・実装・レビューに自分で関わることを大切にしています。",
  },
  {
    title: "AI に任せて、人が確かめる",
    body: "実装の多くを AI コーディングエージェントに任せながら、設計の判断、レビュー、テストは人が担います。速さと品質を両立できる進め方を探っています。",
  },
  {
    title: "公開まで持ち切る",
    body: "作って終わりではなく、ストアに公開し、実際に使ってもらえる状態まで仕上げることを目標にしています。",
  },
];

const certifications = [
  "情報セキュリティスペシャリスト試験",
  "ソフトウェア開発技術者試験",
  "Red Hat 認定スペシャリスト - OpenShift Administration",
];
---

<Layout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <section class="grid gap-10 lg:grid-cols-[0.72fr_1fr] lg:items-start">
      <div class="animate">
        <p class="eyebrow">About</p>
        <div class="mt-5 flex items-center gap-5">
          <Image
            src={avatar}
            alt="あんでぃのアイコン"
            width={192}
            height={192}
            loading="eager"
            class="size-20 rounded-full bg-white shadow-lg ring-4 shadow-brand-900/10 ring-white sm:size-24"
          />
          <div>
            <h1 class="page-title">あんでぃ</h1>
            <p class="mt-2 text-sm text-slate-500">
              Software Engineer / App Developer
            </p>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-2">
          {
            SOCIALS.map((SOCIAL) => (
              <a
                href={SOCIAL.HREF}
                target="_blank"
                rel="noreferrer"
                class="btn btn-secondary"
              >
                {SOCIAL.NAME}
              </a>
            ))
          }
        </div>
      </div>

      <div class="animate space-y-5 text-base leading-8 text-slate-600">
        <p>
          はじめまして、あんでぃです。国内の IT
          企業で約20年、ソフトウェア開発に携わってきました。Java
          のミドルウェア製品の開発から始まり、コンテナ運用管理製品、生成 AI
          向けの SaaS と、領域を広げながら設計・実装を続けてきました。
        </p>
        <p>
          直近は React / TypeScript
          を中心としたフロントエンド開発を担当しながら、スクラムマスターやプロダクトオーナーとしてチームとプロダクトの両方を見る経験も積みました。
        </p>
        <p>
          個人開発では、AI
          コーディングエージェントを相棒に、企画から設計、実装、App Store
          での公開、公開後の改善までを一人で行っています。暮らしの中の小さな困りごとを、続けやすいアプリにすることを目指しています。
        </p>
      </div>
    </section>

    <section class="mt-20">
      <div class="animate">
        <p class="eyebrow">Career</p>
        <h2 class="mt-4 text-3xl font-bold text-slate-800">これまでの経歴</h2>
      </div>
      <ol class="mt-8 divide-y divide-slate-200">
        {
          career.map((item) => (
            <li class="animate grid gap-2 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
              <p class="text-sm font-medium text-slate-500 tabular-nums">
                {item.period}
              </p>
              <div>
                <h3 class="font-bold text-slate-800">{item.title}</h3>
                <p class="mt-2 text-sm leading-7 text-slate-600">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-20 grid gap-8 lg:grid-cols-[0.72fr_1fr] lg:items-start">
      <div class="animate">
        <p class="eyebrow">Skills</p>
        <h2 class="mt-4 text-3xl font-bold text-slate-800">使っている技術</h2>
      </div>
      <dl class="grid gap-6">
        {
          skills.map((skill) => (
            <div class="animate border-t border-slate-200 pt-5">
              <dt class="text-xs font-medium text-slate-500 uppercase">
                {skill.category}
              </dt>
              <dd class="mt-3 flex flex-wrap gap-2">
                {skill.items.map((item) => (
                  <span class="chip">{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-20 border-y border-slate-200 py-16">
      <div class="animate">
        <p class="eyebrow">Values</p>
        <h2 class="mt-4 text-3xl font-bold text-slate-800">
          開発で大切にしていること
        </h2>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          values.map((value) => (
            <section class="animate border-t border-slate-200 pt-5">
              <h3 class="font-bold text-slate-800">{value.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">{value.body}</p>
            </section>
          ))
        }
      </div>
    </section>

    <section class="mt-16 grid gap-10 lg:grid-cols-[0.72fr_1fr] lg:items-start">
      <div class="animate">
        <p class="eyebrow">Certifications</p>
        <h2 class="mt-4 text-2xl font-bold text-slate-800">資格</h2>
        <ul class="mt-5 space-y-2 text-sm leading-7 text-slate-600">
          {certifications.map((certification) => <li>{certification}</li>)}
        </ul>
      </div>

      <div
        class="animate rounded-3xl border border-brand-100 bg-linear-to-br from-brand-50 via-white to-white p-8"
      >
        <p class="eyebrow">Contact</p>
        <h2 class="mt-4 text-2xl font-bold text-slate-800">
          お気軽にご連絡ください
        </h2>
        <p class="mt-4 leading-8 text-slate-600">
          アプリへのご意見や、開発に関するご相談があれば、お問い合わせフォームからお送りください。
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/projects" class="btn btn-primary">アプリを見る</a>
          <a href="/contact" class="btn btn-secondary">お問い合わせ</a>
        </div>
      </div>
    </section>
  </Container>
</Layout>
