---
interface Props {
  type?: "default" | "info" | "warning" | "error";
}
const { type = "default" } = Astro.props;
let emoji = "💡";
if (type === "info") {
  emoji = "ℹ️";
} else if (type === "warning") {
  emoji = "⚠️";
} else if (type === "error") {
  emoji = "🚨";
}

const baseClasses = "relative my-4 flex rounded-2xl border p-4";
const typeClasses = {
  default: "border-brand-200 bg-brand-50 text-slate-700",
  info: "border-sky-200 bg-sky-50 text-sky-900",
  warning: "border-amber-200 bg-amber-50 text-amber-900",
  error: "border-red-200 bg-red-50 text-red-900",
};
---

<div class:list={["not-prose", baseClasses, typeClasses[type]]}>
  <span class="pointer-events-none pr-3 text-xl select-none">{emoji}</span>
  <slot />
</div>
