---
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute -top-16 right-0">
        <BackToTop />
      </div>
    </div>
    <div
      class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
    >
      <div class="space-y-1.5">
        <div class="font-display font-bold text-slate-800">
          あんでぃのポートフォリオ
        </div>
        <div class="text-slate-500">Thoughtful apps for everyday routines.</div>
      </div>
      {
        SOCIALS.length > 0 && (
          <div class="flex flex-wrap items-center gap-2">
            {SOCIALS.map((SOCIAL) => (
              <a
                href={SOCIAL.HREF}
                target="_blank"
                rel="noreferrer"
                class="rounded-full border border-slate-200 bg-white px-4 py-2 text-slate-600 transition-colors hover:border-brand-300 hover:text-brand-700 focus-visible:border-brand-300 focus-visible:text-brand-700"
                aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
              >
                {SOCIAL.NAME}
              </a>
            ))}
          </div>
        )
      }
    </div>
    <div class="mt-8 border-t border-slate-200/80 pt-6 text-xs text-slate-500">
      &copy; {new Date().getFullYear()}
      {SITE.TITLE}
    </div>
  </Container>
</footer>
