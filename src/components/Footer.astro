---
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute -top-12 right-0">
        <BackToTop />
      </div>
    </div>
    <div
      class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
    >
      <div class="space-y-1">
        <div class="font-medium text-[#17211d]">
          &copy; {new Date().getFullYear()}
          {SITE.TITLE}
        </div>
        <div class="text-[#17211d]/55">
          Thoughtful apps for everyday routines.
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {
          SOCIALS.map((SOCIAL) => (
            <a
              href={SOCIAL.HREF}
              target="_blank"
              rel="noreferrer"
              class="rounded-md border border-[#17211d]/10 px-3 py-2 text-[#17211d]/70 transition-colors hover:border-[#1d6f5c]/35 hover:text-[#17211d]"
              aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
            >
              {SOCIAL.NAME}
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</footer>
