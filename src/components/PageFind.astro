---
import "@pagefind/default-ui/css/ui.css";
---

<aside data-pagefind-ignore>
  <div
    transition:persist
    id="backdrop"
    class="invisible fixed top-0 left-0 z-50 flex h-screen w-full justify-center bg-slate-900/15 p-6 backdrop-blur-xs"
  >
    <div
      id="pagefind-container"
      class="m-0 flex h-fit max-h-[80%] w-full max-w-(--breakpoint-sm) flex-col overflow-auto rounded-2xl border border-slate-200 bg-white px-5 py-4 shadow-2xl shadow-slate-900/10"
    >
      <div id="search" class="pagefind-ui pagefind-init"></div>
      <div class="mr-2 pt-4 pb-1 text-right text-xs">
        Press <span class="prose text-xs"><kbd class="">Esc</kbd></span> or click
        anywhere to close
      </div>
    </div>
  </div>
</aside>

<script>
  // astro-pagefind 2 switched to the Component UI, so initialize the Default UI here
  import { PagefindUI } from "@pagefind/default-ui";

  function initPagefind() {
    // #search lives inside a transition:persist element, so initialize only once
    const el = document.querySelector("#search.pagefind-init");
    if (!el) return;
    new PagefindUI({
      element: "#search",
      bundlePath: `${import.meta.env.BASE_URL}pagefind/`,
      showImages: false,
      excerptLength: 15,
      resetStyles: false,
    });
    el.classList.remove("pagefind-init");
  }

  document.addEventListener("astro:page-load", initPagefind);
</script>

<script is:inline>
  const magnifyingGlass = document.getElementById("magnifying-glass");
  const backdrop = document.getElementById("backdrop");

  function openPagefind() {
    const searchDiv = document.getElementById("search");
    const search = searchDiv.querySelector("input");
    setTimeout(() => {
      search.focus();
    }, 0);
    backdrop?.classList.remove("invisible");
    backdrop?.classList.add("visible");
  }

  function closePagefind() {
    const search = document.getElementById("search");
    search.value = "";
    backdrop?.classList.remove("visible");
    backdrop?.classList.add("invisible");
  }

  // open pagefind
  magnifyingGlass?.addEventListener("click", () => {
    openPagefind();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "/") {
      e.preventDefault();
      openPagefind();
    } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openPagefind();
    }
  });

  // close pagefind
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closePagefind();
    }
  });

  // close pagefind when searched result(link) clicked
  document.addEventListener("click", (event) => {
    if (event.target.classList.contains("pagefind-ui__result-link")) {
      closePagefind();
    }
  });

  backdrop?.addEventListener("click", (event) => {
    if (!event.target.closest("#pagefind-container")) {
      closePagefind();
    }
  });

  // prevent form submission
  const form = document.getElementById("form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
  });
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.75;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: var(--font-sans);
    --pagefind-ui-primary: var(--color-brand-600);
    --pagefind-ui-text: var(--color-slate-700);
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: var(--color-slate-200);
    --pagefind-ui-tag: var(--color-slate-100);
  }

  #search input {
    font-weight: normal;
  }

  #search p {
    font-weight: normal;
  }

  #search .pagefind-ui__result-title {
    font-weight: 600;
  }

  #search .pagefind-ui__message {
    padding: 0;
    padding-bottom: 0.75rem;
  }
</style>
