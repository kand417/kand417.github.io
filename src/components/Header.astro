---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
import { Image } from "astro:assets";
import avatar from "@assets/avatar.png";
---

<header transition:persist>
  <Container>
    <div class="flex items-center justify-between gap-4">
      <Link href="/" underline={false} class="group flex items-center gap-3">
        <Image
          src={avatar}
          alt=""
          width={72}
          height={72}
          loading="eager"
          class="size-9 rounded-full border border-[#17211d]/10 shadow-sm shadow-[#17211d]/5 transition-colors group-hover:border-[#1d6f5c]/40 dark:border-white/10"
        />
        <span class="sr-only flex-col leading-none sm:not-sr-only sm:flex">
          <span class="font-semibold text-[#17211d] dark:text-white"
            >{SITE.TITLE}</span
          >
          <span
            class="hidden text-xs text-[#17211d]/55 sm:inline dark:text-white/55"
            >Independent App Developer</span
          >
        </span>
      </Link>
      <nav
        class="flex items-center gap-1.5 text-[13px] whitespace-nowrap sm:gap-2 sm:text-sm"
        aria-label="Primary"
      >
        <Link href="/about" underline={false}>自己紹介</Link>
        <Link href="/projects" underline={false}>アプリ</Link>
        <Link href="/blog" underline={false}>ブログ</Link>
        <Link href="/contact" underline={false}>お問い合わせ</Link>
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="grid size-9 place-items-center rounded-md border border-[#17211d]/10 bg-white text-[#17211d]/70 transition-colors duration-300 ease-in-out hover:border-[#1d6f5c]/40 hover:text-[#17211d] focus-visible:border-[#1d6f5c]/40 focus-visible:text-[#17211d] dark:border-white/10 dark:bg-white/5 dark:text-white/70 dark:hover:text-white dark:focus-visible:text-white"
        >
          <svg
            height="16"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="16"
            style="color: currentcolor;"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
              fill="currentColor"></path></svg
          >
        </button>
      </nav>
    </div>
  </Container>
</header>
