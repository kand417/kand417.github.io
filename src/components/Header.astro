---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { Image } from "astro:assets";
import avatar from "@assets/avatar.png";

const navItems = [
  { href: "/about", label: "自己紹介" },
  { href: "/projects", label: "アプリ" },
  { href: "/blog", label: "ブログ" },
  { href: "/contact", label: "お問い合わせ" },
];
---

<header transition:persist>
  <Container>
    <div class="flex items-center justify-between gap-4">
      <Link
        href="/"
        underline={false}
        class="group flex items-center gap-2.5 hover:text-current focus-visible:text-current"
      >
        <Image
          src={avatar}
          alt=""
          width={72}
          height={72}
          loading="eager"
          class="size-9 rounded-full bg-white shadow-sm ring-2 shadow-slate-900/10 ring-white transition-transform duration-500 ease-out-soft group-hover:scale-105 group-hover:-rotate-6"
        />
        <span
          class="sr-only font-display font-bold tracking-wide text-slate-800 sm:not-sr-only"
          >あんでぃのポートフォリオ</span
        >
      </Link>
      <nav
        class="flex items-center gap-0.5 text-[13px] font-medium whitespace-nowrap sm:gap-1 sm:text-sm"
        aria-label="Primary"
      >
        {
          navItems.map((item) => (
            <Link
              href={item.href}
              underline={false}
              data-nav-link
              class="rounded-full px-2 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 focus-visible:text-slate-900 aria-[current=page]:bg-brand-50 aria-[current=page]:text-brand-700 sm:px-3"
            >
              {item.label}
            </Link>
          ))
        }
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="ml-1 grid size-9 place-items-center rounded-full border border-slate-200 bg-white/80 text-slate-500 transition-colors duration-300 ease-in-out hover:border-brand-300 hover:text-brand-700 focus-visible:border-brand-300 focus-visible:text-brand-700"
        >
          <svg
            height="16"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="16"
            style="color: currentcolor;"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
              fill="currentColor"></path></svg
          >
        </button>
      </nav>
    </div>
  </Container>
</header>
