---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
  class?: string;
};

const {
  href,
  external,
  underline = true,
  group = false,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  rel={external ? "noreferrer" : undefined}
  class={cn(
    "inline-block text-current decoration-brand-300 transition-colors duration-300 ease-in-out hover:text-brand-700 hover:decoration-brand-500 focus-visible:text-brand-700 focus-visible:decoration-brand-500",
    underline && "underline underline-offset-[3px]",
    group && "group",
    className,
  )}
  {...rest}
>
  <slot />
</a>
