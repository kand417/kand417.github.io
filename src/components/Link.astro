---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
  class?: string;
};

const {
  href,
  external,
  underline = true,
  group = false,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  rel={external ? "noreferrer" : undefined}
  class={cn(
    "inline-block text-current decoration-[#1d6f5c]/40 transition-colors duration-300 ease-in-out hover:text-[#1d6f5c] hover:decoration-[#1d6f5c] focus-visible:text-[#1d6f5c] focus-visible:decoration-[#1d6f5c] dark:decoration-[#69c4ad]/50 dark:hover:text-[#69c4ad] dark:hover:decoration-[#69c4ad] dark:focus-visible:text-[#69c4ad] dark:focus-visible:decoration-[#69c4ad]",
    underline && "underline underline-offset-[3px]",
    group && "group",
    className,
  )}
  {...rest}
>
  <slot />
</a>
